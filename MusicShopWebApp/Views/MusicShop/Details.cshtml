@{
    ViewData["Title"] = "Details";
}
@model MusicInstrument

<img src="~/images/guitar.png" width="30%"/>
<form>
    <div class="form-group col-md-5">
        <label for="id">Id:</label>
        <input disabled value="@Model.Id" class="form-control" name="id" />
    </div>
    <div class="form-group col-md-5">
        <label for="name">Название:</label>
        <input disabled value="@Model.Name" class="form-control" name="name" />
    </div>
    <div class="form-group col-md-5">
        <label for="material">Материал:</label>
        <input disabled value="@Model.Material" class="form-control" name="material" />
    </div>
    <div class="form-group col-md-5">
        <label for="price">Цена:</label>
        <input disabled value="@Model.Price" class="form-control" name="price" />
    </div>
    <div class="form-group col-md-5">
        <label for="warranty">Гарантия:</label>
        <input disabled value="@Model.WarrantySupported.ToString()" class="form-control" name="warranty" />
    </div>
    <a href="#" class="btn btn-success">Купить</a>
</form>